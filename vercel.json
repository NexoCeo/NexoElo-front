{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexoelo.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://nexoelo.onrender.com/uploads/:path*"
    },
    {
      "source": "/hubs/:path*",
      "destination": "https://nexoelo.onrender.com/hubs/:path*"
    },
    {
      "source": "/((?!assets/|.*\\.[^/]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
